        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n\n    CUSTOMER {\n        BIGINT customer_id PK\n        VARCHAR name\n        VARCHAR phone\n        VARCHAR email UK\n        VARCHAR password\n        DATETIME created_at\n    }\n\n    EMPLOYEE {\n        BIGINT employee_id PK\n        VARCHAR name\n        VARCHAR phone\n        VARCHAR email\n    }\n\n    VEHICLE {\n        BIGINT vehicle_id PK\n        VARCHAR license_plate UK\n        VARCHAR brand\n        VARCHAR model\n        INT year\n        DECIMAL price_per_hour\n        VARCHAR status\n    }\n\n    PROMOTION {\n        BIGINT promotion_id PK\n        VARCHAR code UK\n        VARCHAR discount_type\n        DECIMAL discount_value\n        DATE start_date\n        DATE end_date\n        INT quantity\n    }\n\n    LICENSE_DOCUMENT {\n        BIGINT license_document_id PK\n        BIGINT customer_id FK\n        BIGINT reviewed_by FK\n        VARCHAR license_number\n        VARCHAR license_class\n        DATE license_expiry\n        VARCHAR image_url\n        VARCHAR status\n        VARCHAR rejection_reason\n        DATETIME submitted_at\n        DATETIME reviewed_at\n    }\n\n    BOOKING {\n        BIGINT booking_id PK\n        BIGINT customer_id FK\n        BIGINT vehicle_id FK\n        BIGINT employee_id FK\n        BIGINT promotion_id FK\n\n        DATETIME delivery_time\n        DATETIME scheduled_end_time\n        DATETIME actual_return_time\n\n        VARCHAR pickup_method\n        VARCHAR return_method\n\n        VARCHAR delivery_address\n        DECIMAL delivery_lat\n        DECIMAL delivery_long\n\n        VARCHAR return_address\n        DECIMAL return_lat\n        DECIMAL return_long\n\n        DECIMAL delivery_fee\n        DECIMAL late_fee\n        DECIMAL total_price\n\n        VARCHAR status\n        DATETIME created_at\n        DATETIME cancelled_at\n    }\n\n    PAYMENT {\n        BIGINT payment_id PK\n        BIGINT booking_id FK\n        VARCHAR payment_type\n        DECIMAL amount\n        VARCHAR status\n        DATETIME paid_at\n    }\n\n    REVIEW {\n        BIGINT review_id PK\n        BIGINT booking_id FK,UK\n        INT rating\n        VARCHAR comment\n        DATETIME created_at\n    }\n\n    CUSTOMER ||--o{ BOOKING : makes\n    CUSTOMER ||--o{ LICENSE_DOCUMENT : submits\n\n    VEHICLE ||--o{ BOOKING : reserved_for\n\n    EMPLOYEE o|--o{ BOOKING : handles\n    EMPLOYEE o|--o{ LICENSE_DOCUMENT : reviews\n\n    PROMOTION o|--o{ BOOKING : applied_to\n\n    BOOKING ||--o{ PAYMENT : has\n    BOOKING ||--o| REVIEW : receives&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="gTHvFneMt7fGMLqj6go3-1">
