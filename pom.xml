<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>
    <groupId>com.crms</groupId>
    <artifactId>car-rental-management-system</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Car Rental Management System</name>
    <properties><java.version>21</java.version></properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-jpa</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-thymeleaf</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-mail</artifactId></dependency>
        <dependency><groupId>io.github.openhtmltopdf</groupId><artifactId>openhtmltopdf-pdfbox</artifactId><version>1.1.31</version></dependency>
        <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc-test</artifactId><scope>test</scope></dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
            <resource>
                <directory>src/main/frontend/screens</directory>
                <filtering>false</filtering>
                <targetPath>templates/screens</targetPath>
                <includes><include>**/*.html</include></includes>
            </resource>
            <resource>
                <directory>src/main/frontend/screens</directory>
                <filtering>false</filtering>
                <targetPath>static/css/screens</targetPath>
                <includes><include>**/*.css</include></includes>
            </resource>
            <resource>
                <directory>src/main/frontend/screens</directory>
                <filtering>false</filtering>
                <targetPath>static/js/screens</targetPath>
                <includes><include>**/*.js</include></includes>
            </resource>
            <resource>
                <directory>src/main/frontend/shared/fragments</directory>
                <filtering>false</filtering>
                <targetPath>templates/fragments</targetPath>
                <includes><include>**/*.html</include></includes>
            </resource>
            <resource>
                <directory>src/main/frontend/shared/layouts</directory>
                <filtering>false</filtering>
                <targetPath>templates/layouts</targetPath>
                <includes><include>**/*.html</include></includes>
            </resource>
            <resource>
                <directory>src/main/frontend/shared/css</directory>
                <filtering>false</filtering>
                <targetPath>static/css/shared</targetPath>
                <includes><include>**/*.css</include></includes>
            </resource>
            <resource>
                <directory>src/main/frontend/shared/js</directory>
                <filtering>false</filtering>
                <targetPath>static/js/shared</targetPath>
                <includes><include>**/*.js</include></includes>
            </resource>
        </resources>
        <plugins>
            <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-javaagent:"${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar"</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
